VITE_SUPABASE_URL=https://furrjspvtmyvjikynkfj.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Maya / ofirbaby Vercel projects (optional — defaults to clinicSite.id "maya")
# VITE_CLINIC_TENANT_ID=maya

# Demo environment only: fake data in browser localStorage, no Supabase.
# Use this in a separate Vercel demo project instead of VITE_SUPABASE_*.
# VITE_DEMO_MODE=true
# לקוחות דמו נוספים: ערוך demo-clients.json (לא משתנה env)
# DEMO_PRIMARY_ORIGIN=https://karinshinanit-demo.vercel.app

# Base44 fallback only. Supabase is used when both VITE_SUPABASE_* values are set.
VITE_BASE44_APP_ID=69ff3dea5e105013fde56ce0
VITE_BASE44_APP_BASE_URL=

# Email (Vercel server only — do NOT prefix with VITE_)
# Used for outbound mail + Meridian treatment-ID inbox verification (IMAP).
# Enable IMAP in the Gmail account and use an App Password.
# Paste App Password with or without spaces — server strips whitespace.
# Must be set on the maya-clinic Vercel project (Production), then Redeploy.
GMAIL_USER=ofirbabyinfo@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
# Who gets "new booking" alerts (comma-separated). Defaults to ADMIN_EMAILS / GMAIL_USER.
# BOOKING_NOTIFY_EMAILS=ofirbabyinfo@gmail.com
# Optional IMAP overrides (defaults to Gmail):
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993
# MERIDIAN_EMAIL_LOOKBACK_DAYS=14
MAYA_CLINIC_NAME=הקליניקה של מאיה
CRON_SECRET=random_long_secret_for_reminders_cron

# Admin login via Google (Gmail) — server only
# Create OAuth client in Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI: https://ofirbaby.vercel.app/api/admin?action=google-callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Comma-separated allowlist (default includes ofirbabyinfo@gmail.com,asaf2310@gmail.com)
ADMIN_EMAILS=ofirbabyinfo@gmail.com,asaf2310@gmail.com,maya@gmail.com
ADMIN_SESSION_SECRET=long_random_secret_for_admin_cookies
# Preferred password (REQUIRED for password login — never commit real values)
ADMIN_ACCESS_PASSWORD=choose_a_long_unique_password
# ADMIN_ACCESS_PASSWORD_2=
# PUBLIC_ORIGIN=https://ofirbaby.vercel.app

# Server-side Supabase (for reminder cron; can reuse anon key or use service role)
SUPABASE_URL=https://furrjspvtmyvjikynkfj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_optional

# Pelecard IFrame/Redirect 2.0 (ManualIframe) — server only, do NOT prefix with VITE_
# Docs: https://gateway20.pelecard.biz/ManualIframe
# PELECARD_TERMINAL=your_terminal
# PELECARD_USER=your_user
# PELECARD_PASSWORD=your_password
# Optional overrides:
# PELECARD_GATEWAY_BASE=https://gateway20.pelecard.biz
# PELECARD_MAX_PAYMENTS=1
# PELECARD_MIN_PAYMENTS=1
# Pelecard CssURL — default is built-in variant-he-4 (native Apple/Google Pay buttons)
# PELECARD_CSS_CDN=https://gateway20.pelecard.biz/Content/Css/variant-he-4.css
# Optional clinic theme (allowlisted): https://ofirbaby.vercel.app/payment/clinic-v4.css
# PELECARD_CSS_URL=https://ofirbaby.vercel.app/api/pelecard/theme
# Optional public origin override for Pelecard callbacks:
# PELECARD_PUBLIC_ORIGIN=https://ofirbaby.vercel.app
# Optional logo in the iframe header
# PELECARD_LOGO_URL=https://ofirbaby.vercel.app/maya-hero.png
# PELECARD_TOP_TEXT=אופיר - מרכז טיפול הוליסטי

